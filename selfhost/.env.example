# Copy to .env next to compose.yaml. Nothing here is a secret of ours: every value is yours to choose.

# Signs session cookies. Any long random string: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ── The model: pick ONE block ────────────────────────────────────────────────────────────────────

# A. Local, keyless, on CPU (docker compose --profile local up). llama.cpp downloads the GGUF named in
#    compose.yaml (LOCAL_MODEL_REPO / LOCAL_MODEL_FILE / LOCAL_MODEL_ALIAS override it).
OPENAI_BASE_URL=http://llama:8080/v1
OPENAI_API_KEY=
MODEL_ALLOWLIST=qwen2.5-0.5b-instruct

# B. Any hosted OpenAI-compatible provider (docker compose up). Mistral's La Plateforme, for example:
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_API_KEY=<your Mistral key>
# MODEL_ALLOWLIST=mistral-large-2512,mistral-small-2506
#    or Hugging Face's router, with your own HF token (an id GET /models lists):
# OPENAI_BASE_URL=https://router.huggingface.co/v1
# OPENAI_API_KEY=<your Hugging Face token>
# MODEL_ALLOWLIST=Qwen/Qwen3-14B

# C. Coming from Open WebUI? Keep its names instead of A or B and leave OPENAI_BASE_URL unset. Lists are
#    ';'-separated with one key per URL (an empty key is a keyless endpoint). Alpha serves one endpoint,
#    so with several the first is used and the log says how many were ignored. When OPENAI_BASE_URL is
#    also set, it wins. Fewer keys than URLs leaves the rest keyless, and extra keys are dropped, as Open WebUI does.
# OPENAI_API_BASE_URLS=https://api.mistral.ai/v1
# OPENAI_API_KEYS=<your Mistral key>
# MODEL_ALLOWLIST=*

# ── Uploads and My files: your scan decision ─────────────────────────────────────────────────────
# A self-host takes file uploads (chat attachments, My files) once you decide how they are checked for
# child sexual abuse material; until then uploads stay off. This file decides for you so the stack works
# on first start: CSAM_SCAN=off stores uploads with NO hash check, each picture logs a line saying so, and
# you own detecting and reporting CSAM. Read the line before you open the stack to anyone else. Either:
CSAM_SCAN=off
#    or remove that line and name a hash-matching scanner (not part of this directory). Once named, it
#    checks every picture and refuses the upload when it cannot answer:
# CSAM_SCAN_PROVIDER=hma
# CSAM_SCAN_BASE_URL=
# CSAM_SCAN_TOKEN=
#    or turn uploads off altogether:
# MULTIMODAL_ENABLED=false

# Files are kept in the `files` volume (CUSTODIAL_STORAGE_BACKEND=local, compose's default). To keep them
# in an S3-compatible bucket, use block S with `docker compose --profile s3 ...` for the bundled
# SeaweedFS, or point CUSTODIAL_S3_ENDPOINT at your own server (leave it unset for AWS S3).
# S. An S3-compatible bucket. The key pair is SeaweedFS's admin identity and the app's credential; make
#    the secret a long random string (openssl rand -hex 32).
# CUSTODIAL_STORAGE_BACKEND=s3
# CUSTODIAL_S3_BUCKET=alpha-files
# CUSTODIAL_S3_ENDPOINT=http://seaweedfs:8333
# CUSTODIAL_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=alpha
# AWS_SECRET_ACCESS_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────
# PORT=3000
# PUBLIC_ORIGIN=http://localhost:3000
# POSTGRES_PASSWORD=alpha
# DEPLOY_ENV=production   # a production boot refuses without ALPHA_EDITION, so set it too:
# ALPHA_EDITION=selfhost  # "hosted" is only for Current AI's own deployments. With selfhost and no safety
#                         # classifier (below), turns go unscreened, and boot logs SELF-HOST, NO SCREEN
# STATUS_PAGE_URL=https://status.example.org   # your Better Stack page for the incident banner. Default: none
# LOCAL_MODELS_DIR=/path/to/gguf-cache   # a host directory for the GGUF in place of the `models` volume

# ── Features (selfhost/README.md explains each and lists every flag's default) ───────────────────
# With no PostHog every flag reads its self-host default; ALPHA_FLAGS overrides single flags
# (alphaFlagOverrides in web/src/lib/chat/server/flags.ts). "+key" on, "-key" off, comma-separated.
# ALPHA_FLAGS=-document-attachments

# Uploads follow the scan decision above (ALPHA_EDITION=selfhost turns MULTIMODAL_ENABLED on unless you
# set it; multimodalMode.ts). PDF and DOCX are read to text and sent with the turn; document-attachments
# is on in self-host, and ALPHA_FLAGS=-document-attachments turns it off (documentAttachmentsGate.ts).

# The safety classifier: set one and every turn is screened, no flag needed (guardGate.ts). Shieldstral
# screens text and pictures; S1 screens text only, turns s1-safety-judge on when both of its lines are
# set, and then text goes to S1 alone. With neither, a self-host answers unscreened.
# With --profile safety, the bundled Shieldstral on CPU (README.md, "A safety screen"):
# GUARD_SHADOW_URL=http://shieldstral:8080
# ZENTROPI_S1_ENDPOINT_URL=
# HF_TOKEN=
# COOP_URL=
# COOP_API_KEY=

# Agent mode needs the service URL and token (agentServiceUrl and agentServiceToken in
# web/src/lib/chat/server/agentMode.ts; together they turn agent-mode on, FLAG_KEYS in
# web/src/lib/chat/server/flagKeys.ts). ALPHA_EDITION=selfhost makes any DEPLOY_ENV eligible
# (agentModeDeployment in agentMode.ts), and agent-mode-access is on in self-host (FLAG_KEYS), so it
# needs no ALPHA_FLAGS entry.
# With ALPHA_EDITION=selfhost, DEPLOY_ENV=production runs with no safety classifier; turns go unscreened.
# AGENT_SERVICE_URL=
# AGENT_SERVICE_TOKEN=

# People's files are stored in PLAINTEXT unless sealing is on (sealWritesOn in
# web/src/lib/chat/server/storage/custodialStorage.ts), and sealing needs a master key (masterSet in
# web/src/lib/chat/server/storage/custodialCrypto.ts). Make an identity with `age-keygen -pq`, then:
# CUSTODIAL_SEAL_WRITES=true
# CUSTODIAL_MASTER_IDENTITIES={"k1":"AGE-SECRET-KEY-PQ-1..."}
# CUSTODIAL_MASTER_ACTIVE=k1

# Mail for sign-in codes and workspace invitations (README "Sign-in"). With none, people sign in with an
# email address and a password instead, and nobody checks the address is theirs.
# SMTP_URL=smtp://user:password@smtp.example.org:587
# SMTP_FROM=Alpha <noreply@example.org>
# With no mail, the first account made on the stack is yours and sign-up closes after it (README
# "Sign-in"). Set this to let anyone who reaches the stack create an account.
# ALPHA_OPEN_SIGNUP=true

# Web search and read-aloud hosts. Each defaults to the hosted service, so leave both unset unless you
# run your own.
# Firecrawl is AGPL and self-hostable with the same v2 API; search and scrape go to <base>/v2/...
# FIRECRAWL_BASE_URL=http://firecrawl:3002
# Read-aloud takes any OpenAI-compatible /audio/speech endpoint; Alpha posts to <base>/audio/speech.
# READ_ALOUD_BASE_URL=http://speech:8880/v1
# Bearer key for that endpoint; unset sends none, and no Hugging Face token is needed.
# READ_ALOUD_API_KEY=
# Model and voice names that endpoint expects; unset sends the Kokoro model and the Kokoro voice for the clip's language.
# READ_ALOUD_MODEL=
# READ_ALOUD_VOICE=
