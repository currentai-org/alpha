--- /dev/null
+++ b/acp_adapter/execute_approval.py
@@ -0,0 +1,265 @@
+"""Pre-execution ACP execute approval helpers.
+
+Mirrors edit_approval.py's mechanism (EditProposal / maybe_require_edit_approval /
+make_acp_edit_approval_requester) but for execute-kind tool calls: terminal, process,
+and execute_code. Before this module existed, Hermes never routed those through
+request_permission at all — no proposal was ever built for them, so a fully-trusted
+`staged` caller (aipotluck.org's CUR-975) got unconfirmed shell access regardless of
+resolved policy. Bound the same way as edit approval: an ACP session sets a requester
+in a ContextVar for the duration of one ACP agent run; CLI, gateway, and other sessions
+leave it unset and therefore bypass this guard, identical to edit_approval.py's own
+module docstring.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+from concurrent.futures import TimeoutError as FutureTimeout
+from contextvars import ContextVar, Token
+from dataclasses import dataclass
+from itertools import count
+from typing import Any, Callable
+
+logger = logging.getLogger(__name__)
+
+# Tool names that grant shell/process access, in aipotluck.org's own terms
+# (api/app.py's _PERMISSION_UNCOVERED = ("terminal", "code_execution")) plus "process"
+# (background-process control — same trust tier as terminal, not previously named there).
+EXECUTE_TOOL_NAMES = frozenset(["terminal", "process", "execute_code"])
+
+
+@dataclass(frozen=True)
+class ExecuteProposal:
+    """A proposed shell/process call that can be shown to an ACP client."""
+
+    tool_name: str
+    summary: str
+    arguments: dict[str, Any]
+
+
+ExecuteApprovalRequester = Callable[[ExecuteProposal], bool]
+
+_EXECUTE_APPROVAL_REQUESTER: ContextVar[ExecuteApprovalRequester | None] = ContextVar(
+    "ACP_EXECUTE_APPROVAL_REQUESTER",
+    default=None,
+)
+_PERMISSION_REQUEST_IDS = count(1)
+
+
+def set_execute_approval_requester(requester: ExecuteApprovalRequester | None) -> Token:
+    """Bind an ACP execute approval requester for the current context."""
+
+    return _EXECUTE_APPROVAL_REQUESTER.set(requester)
+
+
+def reset_execute_approval_requester(token: Token) -> None:
+    """Restore a previous execute approval requester binding."""
+
+    _EXECUTE_APPROVAL_REQUESTER.reset(token)
+
+
+def clear_execute_approval_requester() -> None:
+    """Clear the current requester; primarily used by tests."""
+
+    _EXECUTE_APPROVAL_REQUESTER.set(None)
+
+
+def get_execute_approval_requester() -> ExecuteApprovalRequester | None:
+    return _EXECUTE_APPROVAL_REQUESTER.get()
+
+
+# Splits a shell line on its top-level pipe/list operators (|, &&, ||, ;) without touching anything
+# inside quotes — a naive str.split("|") would also cut a `|` sitting inside a quoted jq filter or
+# awk program, silently producing a wrong decomposition instead of a merely absent one. One pass,
+# quote-state tracked by hand rather than pulled in as a shlex dependency this module doesn't
+# otherwise need.
+_PIPELINE_OPERATORS = ("&&", "||", "|", ";")
+
+
+def _split_pipeline(command: str) -> list[tuple[str | None, str]]:
+    """Returns (operator, stage) pairs — the operator that PRECEDES each stage (None for the first),
+    so a caller can render `&&`/`;`/`||` distinctly from `|` instead of flattening every join into
+    "piped", which would misrepresent a sequential command as one that pipes output downstream."""
+    stages: list[tuple[str | None, str]] = []
+    current = ""
+    op_before: str | None = None
+    quote: str | None = None
+    i = 0
+    while i < len(command):
+        ch = command[i]
+        if quote:
+            current += ch
+            if ch == quote and command[i - 1 : i] != "\\":
+                quote = None
+            i += 1
+            continue
+        if ch in ("'", '"'):
+            quote = ch
+            current += ch
+            i += 1
+            continue
+        matched = next((op for op in _PIPELINE_OPERATORS if command.startswith(op, i)), None)
+        if matched:
+            if current.strip():
+                stages.append((op_before, current.strip()))
+            op_before = matched
+            current = ""
+            i += len(matched)
+            continue
+        current += ch
+        i += 1
+    if current.strip():
+        stages.append((op_before, current.strip()))
+    return stages
+
+
+def _describe_stage(stage: str) -> str:
+    """One pipeline stage's own binary, named, plus any redirection target — the two things a
+    reviewer actually needs to judge one stage of a pipe, separated from the rest of its arguments
+    rather than left to compete with them inside one long line."""
+    binary = stage.split(None, 1)[0] if stage.split(None, 1) else stage
+    redirect = ""
+    for op in (">>", ">"):
+        if op in stage:
+            target = stage.split(op, 1)[1].strip().split(None, 1)
+            if target:
+                redirect = f" {op} {target[0]}"
+            break
+    return f"{binary}{redirect}"
+
+
+def _summarize(tool_name: str, arguments: dict[str, Any]) -> str:
+    """A short, human-legible description of the call for the confirm prompt. Best-effort — an
+    argument shape this doesn't recognize still produces a usable (if generic) summary rather than
+    raising, since a failed summary must never block the approval flow itself.
+
+    CUR-1180: a `terminal` call used to render as the raw command string, truncated at 500 chars —
+    a multi-stage pipe (`curl ... | xargs ... | jq ...`) and a single safe command read as one
+    equally opaque blob. This decomposes a pipeline into its stages so a reviewer sees each binary
+    and redirection target named on its own, instead of having to parse a shell line themselves in
+    the few seconds a confirm card gives them. Purely presentational and purely mechanical — no
+    judgment about which stage is "dangerous," since that call belongs to the human reading it, not
+    to a heuristic here. The full raw command still travels unchanged in raw_input (see
+    build_acp_execute_tool_call below); nothing about what actually runs depends on this function."""
+    if tool_name == "terminal":
+        command = str(arguments.get("command") or arguments.get("cmd") or "")
+        stages = _split_pipeline(command)
+        if len(stages) <= 1:
+            return command[:500]
+        parts = [_describe_stage(stages[0][1])]
+        for op, stage in stages[1:]:
+            parts.append(f" {op} {_describe_stage(stage)}")
+        return "".join(parts)[:500]
+    if tool_name == "execute_code":
+        return str(arguments.get("code") or arguments.get("script") or "")[:500]
+    if tool_name == "process":
+        action = arguments.get("action") or ""
+        target = arguments.get("command") or arguments.get("pid") or ""
+        return f"{action} {target}".strip()[:500]
+    return str(arguments)[:500]
+
+
+def build_execute_proposal(tool_name: str, arguments: dict[str, Any]) -> ExecuteProposal | None:
+    """Return an execute proposal for supported shell/process calls, or None for anything else."""
+
+    if tool_name not in EXECUTE_TOOL_NAMES:
+        return None
+    return ExecuteProposal(
+        tool_name=tool_name,
+        summary=_summarize(tool_name, arguments),
+        arguments=dict(arguments),
+    )
+
+
+def maybe_require_execute_approval(tool_name: str, arguments: dict[str, Any]) -> str | None:
+    """Run ACP execute approval if bound.
+
+    Returns a JSON tool-error string when the call must be blocked, otherwise ``None`` so dispatch
+    can continue. Requester exceptions deny by default — same fail-closed posture as
+    maybe_require_edit_approval.
+    """
+
+    requester = get_execute_approval_requester()
+    if requester is None:
+        return None
+
+    proposal = build_execute_proposal(tool_name, arguments)
+    if proposal is None:
+        return None
+
+    try:
+        approved = bool(requester(proposal))
+    except Exception as exc:
+        logger.warning("ACP execute approval requester failed: %s", exc)
+        approved = False
+
+    if approved:
+        return None
+    return json.dumps(
+        {"error": "Execute approval denied by ACP client; command was not run."},
+        ensure_ascii=False,
+    )
+
+
+def build_acp_execute_tool_call(proposal: ExecuteProposal):
+    """Build the ToolCallUpdate payload for ACP request_permission."""
+
+    import acp
+
+    tool_call_id = f"execute-approval-{next(_PERMISSION_REQUEST_IDS)}"
+    return acp.update_tool_call(
+        tool_call_id,
+        title=f"Approve {proposal.tool_name}: {proposal.summary}",
+        kind="execute",
+        status="pending",
+        raw_input={"tool": proposal.tool_name, "arguments": proposal.arguments},
+    )
+
+
+def make_acp_execute_approval_requester(
+    request_permission_fn: Callable,
+    loop: asyncio.AbstractEventLoop,
+    session_id: str,
+    timeout: float | None = None,
+) -> ExecuteApprovalRequester:
+    """Return a sync requester that bridges execute proposals to ACP permissions."""
+
+    def _requester(proposal: ExecuteProposal) -> bool:
+        from acp.schema import PermissionOption
+        from agent.async_utils import safe_schedule_threadsafe
+
+        options = [
+            PermissionOption(option_id="allow_once", kind="allow_once", name="Allow"),
+            PermissionOption(option_id="deny", kind="reject_once", name="Deny"),
+        ]
+        tool_call = build_acp_execute_tool_call(proposal)
+        coro = request_permission_fn(
+            session_id=session_id,
+            tool_call=tool_call,
+            options=options,
+        )
+        future = safe_schedule_threadsafe(
+            coro,
+            loop,
+            logger=logger,
+            log_message="Execute approval request: failed to schedule on loop",
+        )
+        if future is None:
+            return False
+        try:
+            from acp_adapter.permissions import resolve_permission_timeout
+
+            response = future.result(timeout=resolve_permission_timeout(timeout))
+        except (FutureTimeout, Exception) as exc:
+            future.cancel()
+            logger.warning("Execute approval request timed out or failed: %s", exc)
+            return False
+        outcome = getattr(response, "outcome", None)
+        return (
+            getattr(outcome, "outcome", None) == "selected"
+            and getattr(outcome, "option_id", None) == "allow_once"
+        )
+
+    return _requester
