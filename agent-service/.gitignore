# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# uv writes this when it provisions the venv, but deps are pinned in requirements*.txt
# (the Dockerfile + Makefile install from those) — keep one source of truth, ignore the stray lock.
uv.lock

# Durable store + sqlite sidecars (runtime data, not source)
*.db
*.db-wal
*.db-shm

# Eval cache (regenerable results, keyed by model+task hash)
eval/cache/

# Coverage artifacts (regenerated by `make test` / pytest-cov)
.coverage
.coverage.*
htmlcov/

# Secrets / local env — NEVER commit
.env
.env.local
*.token

# Rendered Fly configs (fly/deploy.sh fills account-specific values into these; the
# tracked *.toml keep their REPLACE placeholders) — NEVER commit account values
fly/*.local.toml

# Local logs / scratch
*.log

# plancheck local artifact
.plancheck-debug.json

# eval harness — transient verdict cache + regenerable run output (the durable record
# is the table in docs/model-tradeoffs.md, not these files)
evals/.cache/
evals/results/

# Internal docs — kept locally, NOT for the (future) public repo.
# Session-handoff + the public-flip checklist live here; the public-facing docs
# (design, wire spec, model matrix, harness writeup, frontends) stay tracked in docs/.
docs/private/

# local MCP config (per-user, carries tokens) — never commit
.mcp.json

# CUR-1189: mutmut's own per-run scratch — regenerated every run, never committed
/mutants
.mutmut-cache
