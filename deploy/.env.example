# Values deploy/compose.yaml reads. Copy to deploy/.env and fill in; compose stops with the name of any
# `:?` value left empty.

# openssl rand -hex 32
BETTER_AUTH_SECRET=
# One OpenAI-compatible base URL ending in /v1 (vLLM, Ollama, LiteLLM, llama.cpp, a hosted provider)
# and its key. A keyless server needs no key.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Where people's files are kept: the bundled SeaweedFS (compose sets CUSTODIAL_STORAGE_BACKEND=s3 for the
# web service). These two keys are shared by the store and the app. openssl rand -hex 16, and
# openssl rand -hex 32.
FILES_ACCESS_KEY=
FILES_SECRET_KEY=

# Optional: another published tag or a digest, e.g. ghcr.io/currentai-org/alpha@sha256:<digest>.
# ALPHA_IMAGE=
