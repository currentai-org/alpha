{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "e29f07b63003a598b1c271f5db7736dcb6a9611b",
  "versioning": "prerelease",
  "prerelease-type": "preview",
  "prerelease": true,
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "web/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "selfhost/compose.release.yaml" },
        { "type": "generic", "path": "deploy/compose.yaml" },
        { "type": "generic", "path": "selfhost/README.md" },
        { "type": "generic", "path": "deploy/README.md" }
      ]
    }
  }
}
