src/lib/chat/
src/routes/chat/
config/
coop/
scripts/
evals/
models/
drizzle/
stub/

# Alpha design-system generated tokens (pnpm ds:tokens owns their format)
../packages/alpha-ds/src/tokens/generated/

# calque's registry: the weekly job appends entries in calque's own format, and a reflow would fail
# every one of its PRs (CUR-2569).
/.calque/

# Inlang/Paraglide working files; only project.inlang/settings.json is tracked.
project.inlang/*
!project.inlang/settings.json
