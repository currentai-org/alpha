		"lint-staged": "^17.4.1",
		"playwright": "^1.63.0",
		"playwright-recast": "0.23.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sade": "^1.8.1",
