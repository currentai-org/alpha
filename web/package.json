{
	"name": "aipotluck-web",
	"private": true,
	"license": "MIT AND Apache-2.0",
	"version": "0.1",
	"packageManager": "pnpm@11.0.8",
	"type": "module",
	"scripts": {
		"dev": "doppler run -- vite dev",
		"dev:local": "bash scripts/dev-local.sh",
		"build": "vite build",
		"gen:models-snapshot": "node scripts/gen-models-snapshot.mjs",
		"build:static": "ADAPTER=static vite build",
		"preview": "doppler run -- vite preview",
		"prepare": "node scripts/compile-i18n.mjs --if-installed && (svelte-kit sync || true)",
		"check": "pnpm i18n:compile && pnpm i18n:check && svelte-kit sync && NODE_OPTIONS=--max-old-space-size=4096 svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n:compile && svelte-kit sync && NODE_OPTIONS=--max-old-space-size=4096 svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --cache --cache-strategy content --cache-location .cache/prettier-check && eslint . --cache --cache-strategy content --cache-location .cache/eslint-main && pnpm run lint:alpha-ds",
		"lint:alpha-ds": "cd ../packages/alpha-ds && prettier --check . --cache --cache-strategy content --cache-location ../../web/.cache/prettier-alpha-ds && eslint . --cache --cache-strategy content --cache-location ../../web/.cache/eslint-alpha-ds",
		"lint:scripts": "eslint --no-config-lookup -c ./eslint.scripts.config.js --cache --cache-strategy content --cache-location .cache/eslint-scripts 'scripts/**/*.{js,mjs,cjs,ts,mts}'",
		"format:scripts": "prettier --ignore-path .gitignore --write",
		"lint:design": "node scripts/ds-tokens.mjs --check && node scripts/ds-version.mjs --check && node scripts/ds-lint-ratchet.mjs",
		"ds:tokens": "node scripts/ds-tokens.mjs",
		"ds:version": "node scripts/ds-version.mjs",
		"ds:change": "node scripts/ds-version.mjs change",
		"lint:quality": "eslint --no-config-lookup -c ./eslint.quality.config.js --cache --cache-strategy content --cache-location .cache/eslint-quality 'src/**/*.{js,mjs,ts}' 'scripts/**/*.{js,mjs,ts}' 'evals/**/*.{js,mjs,ts}' 'config/**/*.{js,mjs,ts}'",
		"audit:async": "eslint --no-config-lookup -c eslint.async-audit.mjs 'src/lib/chat/server/**/*.ts'",
		"security:sast": "semgrep scan --config p/javascript --config p/typescript --config p/security-audit --config p/owasp-top-ten --config p/nodejs --exclude .vendor-refs --exclude stub --error",
		"security:secrets": "gitleaks detect --source .. --no-banner",
		"format": "prettier --write .",
		"test": "vitest",
		"test:ci": "pnpm test:ci:fast && pnpm test:ci:stateful",
		"test:ci:fast": "CI_HERMETIC=true vitest run --project=server-fast",
		"test:imports": "CI_HERMETIC=true vitest run --project=server-fast --experimental.importDurations.print --experimental.importDurations.limit=10",
		"test:ci:stateful": "CI_HERMETIC=true vitest run --project=server-stateful --no-file-parallelism --maxWorkers=1",
		"test:ci:coverage": "CI_HERMETIC=true vitest run --coverage",
		"test:live": "VITEST_LIVE=1 vitest run --project=server-live",
		"test:client": "VITEST_BROWSER=true vitest run --project=client",
		"test:project-grouping": "VITEST_BROWSER=true vitest run src/lib/chat/utils/producedNoAnswer.svelte.spec.ts src/lib/chat/server/db/parsePositiveInt.spec.ts",
		"test:e2e:scenarios": "playwright test --config=e2e/playwright.config.ts",
		"test:e2e:visual": "playwright test --config=e2e/visual/playwright.config.ts",
		"test:non-hermetic": "TEST_LIVE=true vitest run --project=server-stateful --no-file-parallelism --maxWorkers=1",
		"db:start": "./scripts/db-start.sh",
		"db:stop": "docker stop aipotluck-dev-pg",
		"db:drift": "./scripts/drizzle-kit.sh generate && git diff --exit-code -- drizzle/",
		"db:generate": "./scripts/drizzle-kit.sh generate",
		"db:migrate": "node scripts/db-migrate.mjs",
		"db:prod-read": "node scripts/prod-db-read.mjs",
		"db:push": "./scripts/drizzle-kit.sh push",
		"env:check": "node scripts/check-prod-env.mjs",
		"probe:output-asker-context": "node scripts/output-asker-context-calibration.mjs",
		"verify:route-configs": "node scripts/verify-route-configs.mjs",
		"verify:prod-config": "node scripts/verify-prod-config.mjs --env production",
		"build:rag-index": "node scripts/build-rag-index.mjs",
		"check:rag-index": "node scripts/build-rag-index.mjs --check",
		"gen:source-credibility": "node scripts/gen-source-credibility.mjs",
		"warm-cache": "node scripts/warm-cache.mjs",
		"check:node-pin": "node scripts/check-node-pin.mjs",
		"check:guard-policy": "node scripts/check-guard-policy.mjs",
		"i18n:compile": "node scripts/compile-i18n.mjs",
		"i18n:check": "node scripts/i18n.mjs check",
		"i18n:translate": "node scripts/i18n.mjs translate"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write --ignore-unknown",
			"eslint --fix --no-warn-ignored",
			"node scripts/ds-lint-ratchet.mjs"
		],
		"scripts/**/*.{js,mjs,cjs,ts,mts}": [
			"prettier --ignore-path .gitignore --write",
			"eslint --fix --no-config-lookup -c ./eslint.scripts.config.js"
		],
		"*.{json,jsonc,css,md,html,yaml,yml}": [
			"prettier --write --ignore-unknown"
		]
	},
