# CUR-923: documented as gitignored in coop/README.md, but neither ".env"/".env.*"
# rule above actually matches a filename that doesn't START with ".env" — these don't.
coop/.coop-secrets.env
coop/.coop-ids.json

# lint --cache (prettier --check / eslint) — content-hash keyed, safe to blow away
/.cache/prettier-check
/.cache/eslint-main
/.cache/eslint-quality
/.cache/eslint-scripts
/.cache/eslint-alpha-ds
/.cache/prettier-alpha-ds

# CUR-1044: local per-flag fuzzing harness output — read locally, never auto-filed, never committed
/.fuzz-findings

# CUR-1189: Stryker's own per-run scratch + HTML report — regenerated every run, never committed
/stryker-tmp
/reports/mutation

# Paraglide output is compiled from project.inlang and messages at dev/build/check time.
/src/lib/paraglide/

# Walkthrough takes (CUR-2789): the trace and video the tour config writes.
e2e/tour-results/

# CUR-2897: a PR preview's flag definitions, written by scripts/bake-flag-definitions.mjs in vercel-build
src/lib/chat/server/flag-definitions.baked.json
