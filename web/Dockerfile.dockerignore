**/node_modules
**/.svelte-kit
**/.cache
**/.env
**/.env.*
!**/.env.example
web/build
web/.vercel
web/test-results
web/playwright-report
web/coverage
# payload/ stays out but for its manifest, which the workspace install reads.
payload/**
!payload/package.json
agent-service
pangolin
notebooks
# Database dumps and volume copies backup.sh writes beside the compose file: people's data, never in an image.
selfhost/backups
deploy/backups
.git
# Nothing the server or the operator CLIs read: test fixtures, the end-to-end specs and load test, and the repository's root data/ (the gap map dataset the server reads
# is web/static/data, which stays).
web/scripts/fixtures
storage-backup/fixtures
web/e2e
web/loadtest
data
# Unit and component tests sit beside the code they test, and the server and the operator CLIs never load them.
**/*.spec.ts
**/*.test.ts
