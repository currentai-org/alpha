# web/.env.example
#
# Every environment variable the app reads, with empty values. Copy the ones you need into
# web/.env.local, which vite.config.ts loads into process.env; a web/.env file is not read.
#
# Markers:
#   [required] a production build needs it to boot; the dev server boots without it
#   [warn]     logged at boot when unset, non-fatal
#   [secret]   a credential: never commit a real value
#
# Generated from config/env-manifest.mjs, which declares every variable the code reads. Most
# configure a hosted service; leave a service's variables unset to run without it.

# ── ADMIN ───────────────────────────────────────────────────────────────────────────────────────
ADMIN_CLI_LOGIN=
# [secret]
ADMIN_TOKEN=
# [secret]
ADMIN_TOKEN_MAX_FAILS=
# [secret]
ADMIN_TOKEN_WINDOW_MIN=

# ── AGENT ───────────────────────────────────────────────────────────────────────────────────────
# Watchdog for an agent-mode turn, in ms. Default 155000, which is also the ceiling: a larger value is clamped (see deadlineLadder.ts). Needs a redeploy to change.
AGENT_GENERATION_TIMEOUT_MS=
# Name shown for the agent model in provenance views.
AGENT_SERVICE_DISPLAY_NAME=
# Model id shown for agent turns. Unset, the agent service reports it at run time.
AGENT_SERVICE_MODEL=
# [secret] Bearer token the app sends to the agent service.
AGENT_SERVICE_TOKEN=
# Base URL of the agent service (agent-service/). An address, not a switch: the agent-mode flag decides whether agent mode is on, and the flag on with this unset is logged as a misconfiguration and agent mode is withheld.
AGENT_SERVICE_URL=

# ── ALLOW ───────────────────────────────────────────────────────────────────────────────────────
# "true" allows the app to be embedded in an iframe on other sites. Read at build time by sveltekit.config.js.
ALLOW_IFRAME=
# "true" sends session cookies without the Secure attribute. For local HTTP only.
ALLOW_INSECURE_COOKIES=

# ── ALPHA ───────────────────────────────────────────────────────────────────────────────────────
# [required] Production must set it to "hosted": a production deployment without it refuses to boot, because a process with no PUBLIC_POSTHOG_KEY would otherwise read each flag's self-host default. "hosted" keeps those defaults off in a process that has no PUBLIC_POSTHOG_KEY on purpose (the unit suites). A self-host sets "selfhost": the self-host compose stack does, and it is what lets a self-host in production mode run without Coop (moderation.ts), keep its own MODEL_ALLOWLIST and role models (committedConfigEnv in config/inference.ts), honour CSAM_SCAN=off, and skip our status page and Hugging Face's embedder. A preview or local process leaves it unset, and then a process with no PUBLIC_POSTHOG_KEY reads each flag's self-host default.
ALPHA_EDITION=
# Self-hosted only (read when PUBLIC_POSTHOG_KEY is unset). Comma-separated flag overrides: "+key" turns a flag on, "-key" turns it off, on top of each key's self-host default in flagKeys.ts. Ignored when PostHog is configured.
ALPHA_FLAGS=
# Self-host with no mailer only. Unset, the first email-and-password account succeeds and password sign-up closes after it, as Open WebUI does; "true" keeps sign-up open to anyone who reaches the stack. A hosted deployment, or a self-host with a mailer, ignores it.
ALPHA_OPEN_SIGNUP=

# ── APP ─────────────────────────────────────────────────────────────────────────────────────────
# Kept from upstream chat-ui. Nothing in the app reads it; scripts/updateLocalEnv.ts only lists it.
APP_BASE=
# Which app this build serves, read at build time. Unset or "site": the site at / and chat under /chat. "chat": chat at the root of its host, with the reserved /chat paths served in place. Any other value fails the build.
APP_SURFACE=

# ── AXIOM ───────────────────────────────────────────────────────────────────────────────────────
# [secret] Query-only Axiom token for scripts/axiom-alert.mjs and the release-soak scripts. The app does not read it.
AXIOM_ALERT_QUERY_TOKEN=
# Axiom dataset the app sends its logs to, alongside stdout. Set together with AXIOM_TOKEN; one without the other is reported on stderr and nothing is shipped. scripts/axiom-alert.mjs queries the same dataset.
AXIOM_DATASET=
# Axiom ingest edge URL, when the datasets live on an edge other than Axiom's default. Unset, ingest goes to api.axiom.co.
AXIOM_INGEST_URL=
# Axiom dataset for security events (sign-ins, rate-limit trips, refused email sends, blocked fetches). Set together with AXIOM_SECURITY_TOKEN. Unset, security events go to the ordinary log.
AXIOM_SECURITY_DATASET=
# [secret] Axiom ingest token for AXIOM_SECURITY_DATASET only.
AXIOM_SECURITY_TOKEN=
# [secret] Axiom token with ingest permission on AXIOM_DATASET; a query-only token fails ingest. Unset, logs go to stdout only.
AXIOM_TOKEN=

# ── BETTERSTACK ─────────────────────────────────────────────────────────────────────────────────
# [secret] Uptime heartbeat URL pinged when the model catalog check passes. Production only.
BETTERSTACK_HB_CATALOG_URL=
# [secret] Uptime heartbeat URL pinged when the moderation service check passes. Production only.
BETTERSTACK_HB_COOP_URL=
# [secret] Uptime heartbeat URL pinged when the database check passes. Production only.
BETTERSTACK_HB_DB_URL=
# [secret] Uptime heartbeat URL pinged while moderation is not failing closed. Production only.
BETTERSTACK_HB_DECLINES_URL=
# [secret] Uptime heartbeat URL pinged when the embeddings check passes. Production only.
BETTERSTACK_HB_EMBEDDINGS_URL=
# [secret] Uptime heartbeat URL pinged when the model check passes. Production only.
BETTERSTACK_HB_MODEL_URL=
# [secret] Uptime heartbeat URL pinged by the warm-up job, so an outside monitor alerts when the pings stop. Production only: a preview sharing it could keep it green while production is down.
BETTERSTACK_HEARTBEAT_URL=

# ── CDN ─────────────────────────────────────────────────────────────────────────────────────────
# Self-hosting behind your own CDN: the tag header it purges by (cache-tag, surrogate-key or edge-cache-tag). CMS pages then carry it beside Vercel-Cache-Tag. Unset on Vercel.
CDN_CACHE_TAG_HEADER=
# [secret] Bearer token sent with the CDN_PURGE_URL request, if your CDN wants one.
CDN_PURGE_TOKEN=
# Self-hosting behind your own CDN: an https endpoint a CMS publish POSTs {"tags":["cms-page"]} to, the shape Cloudflare purge-by-tag takes. Unset on Vercel, which purges its own edge.
CDN_PURGE_URL=

# ── CI ──────────────────────────────────────────────────────────────────────────────────────────
# Test only: "true" skips the live model catalog at boot and stops stateful Vitest at the first failure. Set by the pnpm test:ci scripts.
CI_HERMETIC=
# [secret] CI only: client id of the issue-tracker app that CI jobs mint a short-lived token from. Without it they fall back to TRIG_LINEAR_API_KEY. The app does not read it.
CI_LINEAR_CLIENT_ID=
# [secret] CI only: client secret paired with CI_LINEAR_CLIENT_ID. The app does not read it.
CI_LINEAR_CLIENT_SECRET=

# ── CLEF ────────────────────────────────────────────────────────────────────────────────────────
# [secret] Key for Auto's hosted draft classifier at CLEF_BASE_URL.
CLEF_API_KEY=
# Base URL of Auto's hosted draft classifier; the model name is appended to it. The clef-routing flag turns it on, and the flag on with this or CLEF_API_KEY unset is logged as a misconfiguration.
CLEF_BASE_URL=
# Which hosted classifier answers: "clef" (default) or "clef-flash".
CLEF_MODEL=

# ── CMS ─────────────────────────────────────────────────────────────────────────────────────────
# [secret] Shared secret for Payload CMS draft previews. Must match the CMS's own CMS_PREVIEW_SECRET; checked against the ?preview= parameter and forwarded to the CMS as x-preview-secret.
CMS_PREVIEW_SECRET=
# [secret] Shared secret the CMS sends in the x-cms-revalidate-secret header when it asks the app to drop cached pages. Must match the CMS's own CMS_REVALIDATE_SECRET.
CMS_REVALIDATE_SECRET=

# ── CONVERSATION ────────────────────────────────────────────────────────────────────────────────
# [secret] Server secret (32+ random bytes, strict hex or base64) for the HMAC-SHA-256 each sealed message carries, held as key id k0. A turn's history from the browser must match it, so a forged earlier message is refused. A value that is not strict hex or base64 is rejected and logged. To rotate, add the new key to CONVERSATION_HISTORY_MAC_KEYS and name it in CONVERSATION_HISTORY_MAC_KEY_ACTIVE, keeping this one until no MAC on k0 is left.
CONVERSATION_HISTORY_MAC_KEY=
# [secret] JSON map of key id to history MAC key ({"<kid>": "<hex or base64>"}) for rotation. Every listed key checks a MAC that names it; a turn that passes re-takes its MACs under the active key, so an old key can be dropped once its chats have been used. A k0 here replaces CONVERSATION_HISTORY_MAC_KEY.
CONVERSATION_HISTORY_MAC_KEYS=
# The key id new history MACs are taken under. Unset: the only key, or k0 when there are several. A kid with no key stops sealing writes, which fail rather than land in plaintext.
CONVERSATION_HISTORY_MAC_KEY_ACTIVE=

# ── COOKIE ──────────────────────────────────────────────────────────────────────────────────────
# Name of the session cookie. Default "hf-chat".
COOKIE_NAME=
# SameSite attribute for the session cookie.
COOKIE_SAMESITE=
# "true" or "false" to force the Secure attribute on the session cookie.
COOKIE_SECURE=

# ── COOP ────────────────────────────────────────────────────────────────────────────────────────
# [warn] [secret] Key for the Coop moderation service. Unset together with COOP_URL, content and child-safety moderation allow everything; only a partial Coop config logs a warning of its own.
COOP_API_KEY=
# Comma-separated Coop actions that block a message. Default "chat-block,chat-block-child".
COOP_BLOCK_ACTIONS=
# Action-name prefix Coop uses for blocks.
COOP_BLOCK_ACTION_PREFIX=
# Coop actions that mean a child-safety block. Default "chat-block-child".
COOP_CHILD_BLOCK_ACTIONS=
# Action-name prefix for child-safety blocks. Default "chat-block-child".
COOP_CHILD_BLOCK_ACTION_PREFIX=
# Link to the Coop dashboard, shown on the admin safety page.
COOP_DASHBOARD_URL=
# Coop item type name for chat messages. Default "ChatMessage".
COOP_ITEM_TYPE=
# Coop item type id for chat messages.
COOP_ITEM_TYPE_ID=
# Coop actions shown as a notice instead of a block. Default empty.
COOP_REDACT_ACTIONS=
# "false" hides the moderation rule's label from the user.
COOP_SURFACE_RULE_LABEL=
# Coop user item id that input-guard hits are reported as. Unset, hits are not forwarded to Coop for review and each skip is logged.
COOP_SYSTEM_REPORTER_ID=
# Test only: "true" enables a deterministic content-policy block for exercising the output-screening path. Refused in production; it never simulates a child-safety block and never sends a report to Coop.
COOP_TEST_OVERRIDE_ENABLED=
# Timeout for one Coop call, in ms. Default 8000.
COOP_TIMEOUT_MS=
# [warn] Base URL of the Coop moderation service. Unset together with COOP_API_KEY, moderation allows everything.
COOP_URL=
# Coop user type id.
COOP_USER_TYPE_ID=
# Path the warm-up job requests to keep the Coop connection open. Default "/health".
COOP_WARM_PATH=

# ── CSAM ────────────────────────────────────────────────────────────────────────────────────────
# Self-host only. "off" records that the operator chose to run no CSAM hash check and owns detecting and reporting CSAM: uploads are stored unscanned (each picture logs a line), and it stands in for the scanner keys in the self-host flag defaults. Honoured only when ALPHA_EDITION is set and is not "hosted"; a hosted deployment ignores it and logs an error once.
CSAM_SCAN=
# Base URL of the optional known-CSAM hash check run on every chat and My files picture, answered by the provider CSAM_SCAN_PROVIDER names. Unset (with CSAM_SCAN_PROVIDER unset too), no hash check runs: uploads are taken and each picture logs one line saying so. Set, the check fails closed: if it cannot be reached the file is refused and the turn's text is still answered, and a match refuses the upload, alerts and reports to Coop.
CSAM_SCAN_BASE_URL=
# Which hash-matching provider answers at CSAM_SCAN_BASE_URL (storage/csamScan.ts). Defaults to "hma", a self-run HMA instance. A name no provider answers to, or a provider with no CSAM_SCAN_BASE_URL, refuses every upload.
CSAM_SCAN_PROVIDER=
# [secret] Bearer token for the proxy in front of the hash check, when it needs one. A wrong or missing token looks the same as a scanner that cannot be reached, so uploads are refused.
CSAM_SCAN_TOKEN=

# ── CUSTODIAL ───────────────────────────────────────────────────────────────────────────────────
# AWS role a Vercel deployment assumes with its own OIDC token to call CUSTODIAL_MASTER_KMS_KEYS, so no AWS secret sits in env. Read on Vercel only: unset there, or on any other host whatever its value, credentials come from the AWS SDK's default chain.
CUSTODIAL_KMS_ROLE_ARN=
# The absolute directory CUSTODIAL_STORAGE_BACKEND=local keeps files in. Back it up with the database: it holds every person's sealed files and their key objects.
CUSTODIAL_LOCAL_DIR=
# Which key id in CUSTODIAL_MASTER_IDENTITIES or CUSTODIAL_MASTER_KMS_KEYS new stored files are encrypted to; /chat/healthcheck reports it as x-custodial-master-kid.
CUSTODIAL_MASTER_ACTIVE=
# [secret] JSON map of key id to age identity ({"<kid>": "AGE-SECRET-KEY-PQ-1..."}) that opens owners' keys in custodial storage. One per deployment, never shared between preview and production. Unset, sealed files cannot be opened; plaintext files still read.
CUSTODIAL_MASTER_IDENTITIES=
# JSON map of key id to AWS KMS key ARN ({"<kid>": "arn:aws:kms:..."}), used in place of CUSTODIAL_MASTER_IDENTITIES so the deployment holds no key that opens files. Key ids share one namespace with the age identities, and CUSTODIAL_MASTER_ACTIVE may name either. Credentials come from CUSTODIAL_KMS_ROLE_ARN on Vercel, else the AWS SDK's default chain (task role, AWS_ROLE_ARN web identity, AWS_PROFILE, or AWS_ACCESS_KEY_ID).
CUSTODIAL_MASTER_KMS_KEYS=
# The bucket CUSTODIAL_STORAGE_BACKEND=s3 stores into. Credentials come from the AWS SDK's default chain (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, AWS_PROFILE, a task or instance role), so none is named here.
CUSTODIAL_S3_BUCKET=
# The S3-compatible server's URL (MinIO, Garage, Ceph, R2...). Unset → AWS S3 in CUSTODIAL_S3_REGION.
CUSTODIAL_S3_ENDPOINT=
# "true" addresses the bucket by path (endpoint/bucket/key) rather than by host. Defaults on when CUSTODIAL_S3_ENDPOINT is set (MinIO and most S3-compatible servers need it); "false" turns it off there.
CUSTODIAL_S3_FORCE_PATH_STYLE=
# The S3 region. Unset → the AWS SDK's own (AWS_REGION). Most S3-compatible servers accept any value, such as us-east-1.
CUSTODIAL_S3_REGION=
# "true" encrypts every file written to custodial storage to its owner's key. Needs CUSTODIAL_MASTER_ACTIVE; without it every write fails. Turning it off leaves sealed files readable.
CUSTODIAL_SEAL_WRITES=
# Self-hosting: where people's files are kept. Required: unset is a configuration error and storage stays unavailable. hf is the Hugging Face bucket in HF_BUCKETS_REPO; s3 is any S3-compatible bucket (CUSTODIAL_S3_*); local is a directory on the server (CUSTODIAL_LOCAL_DIR). Files are stored as written unless CUSTODIAL_SEAL_WRITES=true, which seals each to its owner before any backend sees it. Any other value leaves storage unavailable and logs why.
CUSTODIAL_STORAGE_BACKEND=

# ── E2E ─────────────────────────────────────────────────────────────────────────────────────────
# [secret] Test only: shared secret that lets end-to-end tests simulate upstream faults, checked against the x-e2e-fault-inject-token header on preview and development only. Never set in production.
E2E_FAULT_INJECT_TOKEN=
# [secret] CI only: write token for the test storage bucket the storage-locations spec uses. The app does not read it.
E2E_LINKED_BUCKET_TOKEN=
# [secret] Test only: shared secret that lets end-to-end tests skip the sign-in code send limit for @example.org addresses on preview and development, and authorizes flag-override cookies on hosted previews. Never set in production.
E2E_OTP_BYPASS_TOKEN=

# ── ENABLE ──────────────────────────────────────────────────────────────────────────────────────
# "true" turns on chat-ui's assistants feature.
ENABLE_ASSISTANTS=
# "true" lets admins override configuration at run time.
ENABLE_CONFIG_MANAGER=

# ── FALLBACK ────────────────────────────────────────────────────────────────────────────────────
# [secret] Key for FALLBACK_BASE_URL. Unset, OPENAI_API_KEY is used. Ignored while FALLBACK_BASE_URL is unset.
FALLBACK_API_KEY=
# Host for the backup lane. Unset, the backup lane uses HF_BASE_URL with HF_TOKEN and HF_BILL_TO.
FALLBACK_BASE_URL=
# The backup host's spelling of the primary model id, if it cases it differently. Never a different model: a lane that asks for one is dropped. Off a Vercel deployment only; on Vercel, config/inference.ts decides.
FALLBACK_MODEL_ID=

# ── FIRECRAWL ───────────────────────────────────────────────────────────────────────────────────
# [warn] [secret] Firecrawl key for general web search. Unset, only the arXiv, Wikipedia and OpenAlex engines answer, and a searched turn still looks cited while missing the open web.
FIRECRAWL_API_KEY=
# Base URL of a self-hosted Firecrawl, which serves the same v2 API (Firecrawl is AGPL). Unset, search and scrape go to https://api.firecrawl.dev.
FIRECRAWL_BASE_URL=
# Time filter applied to every Firecrawl search.
FIRECRAWL_TBS=

# ── FOLKWAYS ────────────────────────────────────────────────────────────────────────────────────
# [secret] Key for the folkways adapter's model catalog. Falls back to OPENAI_API_KEY, then HF_TOKEN.
FOLKWAYS_CATALOG_API_KEY=
# Base URL of the model catalog the folkways adapter's /models route forwards to.
FOLKWAYS_CATALOG_BASE_URL=
# Community name the folkways adapter reports.
FOLKWAYS_COMMUNITY=
# Deployment name the folkways adapter reports.
FOLKWAYS_DEPLOYMENT=
# Fallback switch for the folkways adapter routes, used only when the PostHog flag cannot be read. Unset or "0", the routes return 404.
FOLKWAYS_ENABLED=
# Environment name the folkways adapter reports. Default "development".
FOLKWAYS_ENVIRONMENT=
# Upstream for the folkways adapter's Mistral route. Default https://api.mistral.ai/v1.
FOLKWAYS_MISTRAL_UPSTREAM_BASE_URL=
# Folkways adapter mode. "observe" reports prompts and content-free traces and passes requests through unchanged; anything else takes the resolve and rewrite path.
FOLKWAYS_MODE=
# [secret] Token the folkways adapter sends to the folkways service.
FOLKWAYS_TOKEN_GATEWAY=
# [secret] Key for the folkways adapter's upstream. Falls back to HF_TOKEN, then OPENAI_API_KEY.
FOLKWAYS_UPSTREAM_API_KEY=
# The folkways adapter's upstream. Default https://router.huggingface.co/v1.
FOLKWAYS_UPSTREAM_BASE_URL=
# Hugging Face organisation billed for the folkways adapter's upstream calls. Falls back to HF_BILL_TO.
FOLKWAYS_UPSTREAM_BILL_TO=
# Base URL of the folkways service. Default http://localhost:4600.
FOLKWAYS_URL=

# ── GIT ─────────────────────────────────────────────────────────────────────────────────────────
# The git branch this deployment was built from (runtimeEnv.js gitRef()). Unset on Vercel, which supplies VERCEL_GIT_COMMIT_REF instead and that is the fallback. Decides the Mistral key lane, the passkey RP ID on develop, the per-PR preview checks and the replay scope, so a host that serves previews must set it.
GIT_REF=
# The commit this deployment was built from (runtimeEnv.js gitSha()). Unset on Vercel, which supplies VERCEL_GIT_COMMIT_SHA instead and that is the fallback. Read at build time for PUBLIC_COMMIT_SHA (sveltekit.config.js, which then asks git) and the PostHog source-map release, and at runtime for log lines and the journeys page.
GIT_SHA=

# ── GITHUB ──────────────────────────────────────────────────────────────────────────────────────
# GitHub OAuth app client id. Set, sign-in offers GitHub; unset, GitHub is absent from the sign-in screen.
GITHUB_CLIENT_ID=
# [secret] GitHub OAuth app client secret.
GITHUB_CLIENT_SECRET=

# ── GOOGLE ──────────────────────────────────────────────────────────────────────────────────────
# Google OAuth client id. Set, sign-in offers Google; unset, Google is absent from the sign-in screen.
GOOGLE_CLIENT_ID=
# [secret] Google OAuth client secret.
GOOGLE_CLIENT_SECRET=

# ── GROUND ──────────────────────────────────────────────────────────────────────────────────────
# Minimum top relevance score for web results to ground an answer. Default 0.5.
GROUND_RELATIVE_MINTOP=
# A result's minimum score as a fraction of the top score. Default 0.25.
GROUND_RELATIVE_RATIO=

# ── GROUNDCHECK ─────────────────────────────────────────────────────────────────────────────────
# [secret] Bearer token for the groundcheck service. Set with GROUNDCHECK_URL.
GROUNDCHECK_TOKEN=
# Base URL of the groundcheck service, which flags unsupported spans in answers. The groundcheck flag decides whether it is used; the flag on with this unset logs a config error and skips the check.
GROUNDCHECK_URL=

# ── HF ──────────────────────────────────────────────────────────────────────────────────────────
# Hugging Face router base URL, used for the backup lane and for models pinned to one Hugging Face provider.
HF_BASE_URL=
# Hugging Face organisation billed for router calls.
HF_BILL_TO=
# [secret] CI only: read token for the preview storage bucket, handed to the custodial-storage spec. The app does not read it.
HF_BUCKETS_READ_TOKEN=
# The custodial storage bucket, as buckets/<owner>/<name>. Unset on a production deployment (DEPLOY_ENV or VERCEL_ENV production) → buckets/current-ai-official/custodial-storage-eu (production's, EU region). Unset anywhere else (preview, local dev, CI, a self-host) → custodial storage is unavailable: the surface is off whatever its flag says, one error is logged, and a direct storage call throws CustodialBucketUnsetError (storage/custodialBucketRepo.ts). Preview sets its own, paired with a HF_BUCKETS_TOKEN scoped to that bucket only, so preview never reads or writes production files. A malformed value throws on first storage call; it never falls back.
HF_BUCKETS_REPO=
# [secret] Hugging Face token scoped to the one bucket HF_BUCKETS_REPO names, with no org or user permissions. Separate from HF_TOKEN; neither falls back to the other.
HF_BUCKETS_TOKEN=
# [secret] Hugging Face token for retrieval embeddings. Falls back to HF_TOKEN.
HF_RAG_EMBEDDINGS_TOKEN=
# Hugging Face OAuth app used only to connect a user's own Hugging Face storage, separate from the sign-in app so its consent can be revoked on its own. Unset with the storage-locations flag on is logged and no Connect button is shown.
HF_STORAGE_OAUTH_CLIENT_ID=
# [secret] Client secret for HF_STORAGE_OAUTH_CLIENT_ID. Never falls back to OPENID_CLIENT_SECRET.
HF_STORAGE_OAUTH_CLIENT_SECRET=
# [secret] Hugging Face token. Among its readers: the Shieldstral guard (detectors/shieldstral.ts, with OPENAI_API_KEY as the fallback). With the `mila-sp-output-guard` flag on, the Mila suicide-prevention classifier on our own Inference Endpoint (detectors/milaSp.ts; threshold and 2 s budget in web/config/safetyScreen.ts, address in MILA_SP_ENDPOINT_URL or, on production and preview, that file) reads it too; flag on with this unset logs an error and checks nothing. Privacy note: with that flag on, the text of every finished English or French answer goes to that endpoint, never the user's own messages.
HF_TOKEN=

# ── LLM ─────────────────────────────────────────────────────────────────────────────────────────
# chat-ui router: name of the default route. Default "default".
LLM_ROUTER_DEFAULT_ROUTE=
# chat-ui router: "true" sends image turns to LLM_ROUTER_MULTIMODAL_MODEL.
LLM_ROUTER_ENABLE_MULTIMODAL=
# chat-ui router: "true" lets the router send tool turns.
LLM_ROUTER_ENABLE_TOOLS=
# chat-ui router: model used when a route's models all fail.
LLM_ROUTER_FALLBACK_MODEL=
# chat-ui router: model for image turns.
LLM_ROUTER_MULTIMODAL_MODEL=
# chat-ui router: path to the routes policy JSON file. Config, not a switch: its flag turns the router on.
LLM_ROUTER_ROUTES_PATH=
# Not read. A feature flag decides whether conversations get generated titles.
LLM_SUMMARIZATION=

# ── LOCALITY ────────────────────────────────────────────────────────────────────────────────────
# "true" turns on the embedding-based locality check. Default off.
LOCALITY_SEMANTIC_ENABLED=
# Similarity threshold for the locality check.
LOCALITY_SEMANTIC_THRESHOLD=

# ── METRICS ─────────────────────────────────────────────────────────────────────────────────────
# "true" serves Prometheus metrics.
METRICS_ENABLED=
# Port for the metrics server. Default 5565.
METRICS_PORT=

# ── MISTRAL ─────────────────────────────────────────────────────────────────────────────────────
# [secret] Key for MISTRAL_BASE_URL. Set MISTRAL_API_KEY, MISTRAL_BASE_URL and MISTRAL_MODELS together; a partial set registers nothing and logs an error.
MISTRAL_API_KEY=
# [secret] A second Mistral key. Set, preview builds of feature branches call MISTRAL_BASE_URL with it directly; unset, they use the MISTRAL_CHAT_* lane like develop.
MISTRAL_API_KEY_CI=
# OpenAI-compatible base URL for Mistral models, for example https://api.mistral.ai/v1.
MISTRAL_BASE_URL=
# [secret] Key for MISTRAL_CHAT_BASE_URL.
MISTRAL_CHAT_API_KEY=
# Alternative host for chat's Mistral models. Read only with MISTRAL_CHAT_API_KEY set, and then replaces MISTRAL_BASE_URL for chat; Mistral web search stays on MISTRAL_BASE_URL.
MISTRAL_CHAT_BASE_URL=
# [secret] A second key for MISTRAL_CHAT_BASE_URL. Set, preview builds of feature branches call the router with it instead of MISTRAL_CHAT_API_KEY, so the router's usage shows CI's share; same Mistral account and limit.
MISTRAL_CHAT_CI_API_KEY=
# Comma-separated ours=theirs pairs for MISTRAL_MODELS ids that MISTRAL_CHAT_BASE_URL names differently, for example mistral-large-2512=mistralai/mistral-large-2512.
MISTRAL_CHAT_MODEL_MAP=
# Comma-separated Mistral model ids served by MISTRAL_BASE_URL, added to the catalog before MODEL_ALLOWLIST applies. Each has only its own host as a lane, with no backup.
MISTRAL_MODELS=

# ── MOCK ────────────────────────────────────────────────────────────────────────────────────────
# Test only: client id for a stand-in sign-in provider.
MOCK_OIDC_CLIENT_ID=
# [secret] Test only: client secret for the stand-in sign-in provider.
MOCK_OIDC_CLIENT_SECRET=
# Test only: URL of the stand-in sign-in provider the sign-in spec walks. Refused in production.
MOCK_OIDC_PROVIDER_URL=

# ── MODELS ──────────────────────────────────────────────────────────────────────────────────────
# JSON5 overrides for model metadata, as in upstream chat-ui.
MODELS=
# "off" stops the server from booting from the committed model snapshot.
MODELS_BOOT_SNAPSHOT=

# ── OAUTH ───────────────────────────────────────────────────────────────────────────────────────
# Open WebUI's name for OIDC_CLIENT_ID, read when that is unset.
OAUTH_CLIENT_ID=
# [secret] Open WebUI's name for OIDC_CLIENT_SECRET.
OAUTH_CLIENT_SECRET=
# Open WebUI's name for OIDC_PROVIDER_NAME.
OAUTH_PROVIDER_NAME=
# Open WebUI's name for OIDC_SCOPES.
OAUTH_SCOPES=

# ── OIDC ────────────────────────────────────────────────────────────────────────────────────────
# Self-hosting: the client id of your organisation's OIDC login.
OIDC_CLIENT_ID=
# [secret] Self-hosting: the client secret paired with OIDC_CLIENT_ID.
OIDC_CLIENT_SECRET=
# Self-hosting: your organisation's OpenID Connect issuer (Keycloak, Authentik, Cognito, Entra...), https, discovered at /.well-known/openid-configuration. With OIDC_CLIENT_ID and OIDC_CLIENT_SECRET it adds a sign-in button; an unreachable issuer drops only that button. OPENID_PROVIDER_URL is read in its place beside OAUTH_CLIENT_ID, as Open WebUI names it.
OIDC_ISSUER=
# Self-hosting: the name on your organisation's sign-in button. Default SSO.
OIDC_PROVIDER_NAME=
# Self-hosting: the scopes your organisation's sign-in asks for, space-separated. Default openid email profile.
OIDC_SCOPES=

# ── OPENAI ──────────────────────────────────────────────────────────────────────────────────────
# Open WebUI's name for the model endpoint: ';'-separated base URLs. Read only while OPENAI_BASE_URL is unset; Alpha serves one endpoint, so the first is used and the rest are logged as ignored. Keys pair with URLs by position in OPENAI_API_KEYS.
OPENAI_API_BASE_URLS=
# [required] [secret] Key for OPENAI_BASE_URL.
OPENAI_API_KEY=
# [secret] Open WebUI's name for the model endpoint's keys: ';'-separated, one per OPENAI_API_BASE_URLS entry (an empty entry is a keyless endpoint). Falls back to OPENAI_API_KEY; with fewer keys than URLs the missing ones are empty, and extra keys are dropped, as Open WebUI does.
OPENAI_API_KEYS=
# [required] Base URL of the OpenAI-compatible endpoint for the open models, ending in /v1. Models are listed from its /models, which is scoped to the key.
OPENAI_BASE_URL=
# Retries the OpenAI client makes on a failed call. Unset means none.
OPENAI_MAX_RETRIES=
# Provider name sent with requests to the gateway.
OPENAI_PROVIDER=

# ── OPENID ──────────────────────────────────────────────────────────────────────────────────────
# OpenID Connect client id for sign-in. Unset, that sign-in option is absent.
OPENID_CLIENT_ID=
# [secret] OpenID Connect client secret.
OPENID_CLIENT_SECRET=
# JSON5 object with the OpenID Connect settings, in place of the separate variables.
OPENID_CONFIG=
# Claim to read the user's display name from.
OPENID_NAME_CLAIM=
# The Hugging Face sign-in's issuer. Beside OAUTH_CLIENT_ID it is instead Open WebUI's name for OIDC_ISSUER, the organisation sign-in's discovery URL.
OPENID_PROVIDER_URL=
# Resource indicator sent with the OpenID Connect request.
OPENID_RESOURCE=
# Scopes requested at sign-in.
OPENID_SCOPES=
# Clock tolerance for token checks.
OPENID_TOLERANCE=

# ── OTP ─────────────────────────────────────────────────────────────────────────────────────────
# Sign-in codes one email address can receive per day. Default 10.
OTP_ADDRESS_MAX_PER_DAY=
# Sign-in codes sent per day, across the site, to addresses with no account. Default 1000.
OTP_SITE_NEW_MAX_PER_DAY=

# ── OUTPUT ──────────────────────────────────────────────────────────────────────────────────────
# "true", "1" or "on" turns on screening of the model's output. On a deployment, screening then fails closed if its moderation config is missing.
OUTPUT_MODERATION=
# Time limit for the whole output-screening phase, in ms. Default 25000. On expiry, whatever already cleared is released (or declined) instead of waiting for the generation watchdog. Separate from COOP_TIMEOUT_MS, which bounds one call.
OUTPUT_SCREEN_PHASE_TIMEOUT_MS=

# ── PANGOLIN ────────────────────────────────────────────────────────────────────────────────────
# Pangolin Integration API base URL, server to server, for user-run local models reached through a tunnel. Local dev: http://localhost:3003 (the pangolin/ stack). Unset, managed endpoints are withheld and the misconfiguration is logged.
PANGOLIN_API_URL=
# Pangolin domain new tunnels are created under. Local dev: "domain1".
PANGOLIN_DOMAIN_ID=
# [secret] Pangolin Integration API key (org-scoped).
PANGOLIN_INTEGRATION_TOKEN=
# Pangolin organisation every tunnel belongs to. One per deployment.
PANGOLIN_ORG_ID=
# Address a user's device dials to open its tunnel; distinct from PANGOLIN_API_URL outside local dev.
PANGOLIN_TUNNEL_ENDPOINT=

# ── PG ──────────────────────────────────────────────────────────────────────────────────────────
# Postgres connect timeout, in seconds. Default 30.
PG_CONNECT_TIMEOUT=
# Postgres idle connection timeout, in seconds. Default 150. Keep it above the one-minute warm-up cadence, or the connection the warm-up holds open closes between runs.
PG_IDLE_TIMEOUT=
# Maximum Postgres pool size.
PG_POOL_MAX=
# "off" stops the server from opening a database connection at boot.
PG_PRECONNECT=

# ── POSTHOG ─────────────────────────────────────────────────────────────────────────────────────
# Absolute https origin of this deployment's PostHog app and management API (config/posthogRegion.mjs): the source-map upload's --host and the flag scripts' API reads. Unset, it follows POSTHOG_INGEST_HOST (eu.i.posthog.com -> eu.posthog.com), which unset means https://eu.posthog.com.
POSTHOG_APP_HOST=
# [secret] PostHog personal key scoped to error_tracking:write, used at build time by scripts/upload-posthog-sourcemaps.mjs to upload client source maps. Unset, the build deletes the maps instead. The running app does not read it.
POSTHOG_CLI_API_KEY=
# [secret] PostHog project id for the source-map upload.
POSTHOG_CLI_PROJECT_ID=
# [secret] PostHog project secret (phs_...) that lets the server evaluate feature flags locally; scripts/bake-flag-definitions.mjs also reads it at build time. Never a personal phx_ key. Unset, flags are evaluated remotely, which works and costs requests.
POSTHOG_FLAGS_SECRET_KEY=
# Absolute https origin of this deployment's PostHog: where the /rs proxy forwards and where the server-side flag and error clients send when PUBLIC_POSTHOG_HOST is relative. Unset means https://eu.i.posthog.com, where production's project 345429 lives since it moved from US. PostHog Cloud's assets host is derived (eu. -> eu-assets.); a self-hosted PostHog serves both from this origin.
POSTHOG_INGEST_HOST=
# The PostHog project the flag scripts read through the management API (config/posthogRegion.mjs). Unset means 345429, the EU project. Not a credential.
POSTHOG_PROJECT_ID=

# ── PUBLIC ──────────────────────────────────────────────────────────────────────────────────────
# Apple app id for the smart app banner.
PUBLIC_APPLE_APP_ID=
# Folder under static/ for logos and favicons. Default "chatui".
PUBLIC_APP_ASSETS=
# App description for page metadata.
PUBLIC_APP_DESCRIPTION=
# [required] Origin of the Payload CMS deployment. Public on purpose: every CMS read is public, and the browser resolves relative media URLs against it. Server-side page reads use it too. Required at boot only on the site surface of a production or preview deployment (`bootReq`); the chat surface and local dev boot without it, and the CMS is then left out of the CSP.
PUBLIC_CMS_PAYLOAD_URL=
# Commit shown in the app. Set at build time from git when unset.
PUBLIC_COMMIT_SHA=
# Kept from upstream chat-ui. Nothing reads it; the public-config route sets its cache headers in code.
PUBLIC_CONFIG_CACHE_HEADERS=
# Announcements shown in the chat window.
PUBLIC_FEATURE_ANNOUNCEMENTS=
# Google Analytics id.
PUBLIC_GOOGLE_ANALYTICS_ID=
# chat-ui router: id of the router's virtual model. Default "omni".
PUBLIC_LLM_ROUTER_ALIAS_ID=
# chat-ui router: display name of the router's virtual model. Default "Omni".
PUBLIC_LLM_ROUTER_DISPLAY_NAME=
# chat-ui router: logo URL for the router's virtual model.
PUBLIC_LLM_ROUTER_LOGO_URL=
# Kept for reference. Nothing reads it; model page links are set in code.
PUBLIC_MODEL_PAGES=
# [required] Origin the app is served from, for example http://localhost:5173. Sign-in builds its callback URLs and passkey RP ID from it.
PUBLIC_ORIGIN=
# Plausible analytics script URL.
PUBLIC_PLAUSIBLE_SCRIPT_URL=
# PostHog host for the browser. Default the same-origin /rs proxy, which forwards to POSTHOG_INGEST_HOST.
PUBLIC_POSTHOG_HOST=
# [secret] PostHog project token. Public by design (write-only). Unset, analytics are off.
PUBLIC_POSTHOG_KEY=
# [secret] The previous PostHog project token, set only while a project move settles. A browser with nothing stored under PUBLIC_POSTHOG_KEY starts from the distinct_id it had under this token (analytics.ts legacyDistinctId), so returning visitors are not counted as new. Unset, or equal to PUBLIC_POSTHOG_KEY, does nothing. Public by design, like the key it replaces.
PUBLIC_POSTHOG_LEGACY_KEY=
# PostHog app host, for links into PostHog.
PUBLIC_POSTHOG_UI_HOST=
# How a turn is judged to need web search: heuristic, model, tool or margin. Any other value, including empty, means heuristic, with no error. scripts/verify-prod-config.mjs checks the value actually served.
PUBLIC_SEARCH_TRIGGER=
# Suffix for page titles when the CMS page has no meta title. Default " – AI Potluck". Keep it in step with the CMS's own SEO_TITLE_SUFFIX.
PUBLIC_SEO_TITLE_SUFFIX=
# Kept from upstream chat-ui. Nothing in the app reads it; scripts/updateLocalEnv.ts only lists it.
PUBLIC_SHARE_PREFIX=

# ── RAG ─────────────────────────────────────────────────────────────────────────────────────────
# Cache lifetime for admin-managed retrieval documents, in ms. Default 60000.
RAG_ADMIN_CACHE_TTL_MS=
# "true" serves the admin-managed retrieval store. Off, documents can still be authored and previewed.
RAG_ADMIN_ENABLED=
# Maximum chunks in the admin-managed retrieval store. Default 2000.
RAG_ADMIN_MAX_CHUNKS=
# Maximum chunks per admin-managed document. Default 50.
RAG_ADMIN_MAX_CHUNKS_PER_DOC=
# Embeddings endpoint for retrieval. Default https://router.huggingface.co/hf-inference/models.
RAG_EMBEDDING_BASE_URL=
# Hugging Face organisation billed for embeddings. Falls back to HF_BILL_TO.
RAG_EMBEDDING_BILL_TO=
# Dedicated embeddings endpoint; when set, called directly in place of RAG_EMBEDDING_BASE_URL. scripts/build-rag-index.mjs reads it too.
RAG_EMBEDDING_ENDPOINT_URL=
# Embedding model. Default sentence-transformers/all-MiniLM-L6-v2.
RAG_EMBEDDING_MODEL=
# [warn] "true" turns on all retrieval grounding, local and federated. Unset, retrieval never runs and nothing is logged.
RAG_ENABLED=
# Minimum similarity for a retrieved chunk to count.
RAG_MIN_SCORE=
# Minimum reranker score for a retrieved chunk to count. Default 0.02.
RAG_RERANK_MIN_SCORE=
# Below this similarity a turn is treated as off-topic without calling the reranker.
RAG_RERANK_SKIP_COSINE_BELOW=
# Reranker timeout for retrieval, in ms. Default 3000.
RAG_RERANK_TIMEOUT_MS=
# [secret] Key for the retrieval source router's model.
RAG_ROUTER_API_KEY=
# Base URL for the retrieval source router's model.
RAG_ROUTER_BASE_URL=
# Cache lifetime of the source catalog, in ms. Default 3600000.
RAG_ROUTER_CATALOG_TTL_MS=
# "true" turns on the retrieval source router. SYFTHUB_PROMPT_ONLY turns it off regardless.
RAG_ROUTER_ENABLED=
# "true" skips retrieval when the router picks no source.
RAG_ROUTER_HONOR_EMPTY=
# Most sources the router may pick. Default 3.
RAG_ROUTER_MAX_ENDPOINTS=
# Model the retrieval source router uses.
RAG_ROUTER_MODEL=
# Hugging Face provider pin for the router's model.
RAG_ROUTER_PROVIDER=
# "true" runs the router without acting on its choice. SYFTHUB_PROMPT_ONLY turns it off regardless.
RAG_ROUTER_SHADOW=
# Router timeout, in ms. Default 4000.
RAG_ROUTER_TIMEOUT_MS=
# Chunks retrieved per turn. Default 5.
RAG_TOP_K=
# Model that captions images for retrieval. Falls back to LLM_ROUTER_MULTIMODAL_MODEL.
RAG_VISION_MODEL=

# ── RATE ────────────────────────────────────────────────────────────────────────────────────────
# Messages per minute per session. Default 20.
RATE_LIMIT=
# Per-IP limit as a multiple of RATE_LIMIT. 0 turns the per-IP limit off.
RATE_LIMIT_IP_MULTIPLIER=

# ── READ ────────────────────────────────────────────────────────────────────────────────────────
# [secret] Bearer key for READ_ALOUD_BASE_URL. Unset, no Authorization header is sent, for a keyless speech server. Ignored while READ_ALOUD_BASE_URL is unset.
READ_ALOUD_API_KEY=
# Base URL of an OpenAI-compatible speech API for read-aloud, ending in /v1; Alpha posts to <base>/audio/speech. Unset, the Hugging Face router route, which uses HF_TOKEN. With this set, read-aloud needs no Hugging Face credential.
READ_ALOUD_BASE_URL=
# Model name sent to READ_ALOUD_BASE_URL's speech server. Unset, hexgrad/Kokoro-82M. Ignored while READ_ALOUD_BASE_URL is unset.
READ_ALOUD_MODEL=
# Voice name sent to READ_ALOUD_BASE_URL's speech server, for every language. Unset, the Kokoro voice for the clip's language. Ignored while READ_ALOUD_BASE_URL is unset.
READ_ALOUD_VOICE=

# ── REPORT ──────────────────────────────────────────────────────────────────────────────────────
# [secret] Linear API key that user answer reports open issues with, when the report-fanout flag is on. Needs REPORT_LINEAR_TEAM_ID. Separate from the CI-only TRIG_LINEAR_API_KEY.
REPORT_LINEAR_API_KEY=
# Linear team id (UUID) that answer-report issues are filed under. Not a credential.
REPORT_LINEAR_TEAM_ID=
# [secret] Webhook that receives a link to each answer report when the report-fanout flag is on. It carries the reason and an admin link, never the answer text. Unset with the flag on, a warning is logged.
REPORT_SLACK_WEBHOOK=

# ── RERANK ──────────────────────────────────────────────────────────────────────────────────────
# Reranker endpoint for web search (cohere transport). Falls back to OPENAI_BASE_URL.
RERANK_BASE_URL=
# Hugging Face organisation billed for reranking. Falls back to HF_BILL_TO.
RERANK_BILL_TO=
# [secret] Token for RERANK_ENDPOINT_URL. Falls back to RERANK_HF_TOKEN, then HF_RAG_EMBEDDINGS_TOKEN, then HF_TOKEN.
RERANK_ENDPOINT_TOKEN=
# Dedicated reranker endpoint (TEI transport); when set, used in place of the other reranker settings.
RERANK_ENDPOINT_URL=
# Hugging Face reranker base URL. Default https://router.huggingface.co.
RERANK_HF_BASE_URL=
# [secret] Hugging Face token for reranking.
RERANK_HF_TOKEN=
# Reranker transport: tei, cohere or hf.
RERANK_KIND=
# Most results sent to the reranker at once. Default 32.
RERANK_MAX_BATCH=
# [warn] Reranker model. Unset, web results are never checked for relevance, so every searched turn answers ungrounded after paying for the search.
RERANK_MODEL=

# ── SECOND ──────────────────────────────────────────────────────────────────────────────────────
# [secret] Key for SECOND_OPINION_BASE_URL. Only the compare lane uses it.
SECOND_OPINION_API_KEY=
# Endpoint for the second-opinion panel and other side-call models.
SECOND_OPINION_BASE_URL=
# Display name of the first second-opinion model.
SECOND_OPINION_DISPLAY_NAME=
# The sequential panel's first seat. On a Vercel deployment config.ts serves ROLE_MODELS in config/inference.ts and ignores this var; it decides only off Vercel (local dev, CI, evals).
SECOND_OPINION_MODEL=

# ── SEMANTIC ────────────────────────────────────────────────────────────────────────────────────
# "false" turns off the embedding check for hedged or evasive answers on grounded turns. Default on. Without it, the regex hedge check still runs.
SEMANTIC_HEDGE_ENABLED=
# Similarity a sentence must reach to count as a hedge or denial. Default 0.4.
SEMANTIC_HEDGE_THRESHOLD=

# ── SMTP ────────────────────────────────────────────────────────────────────────────────────────
# Sender for SMTP_URL, e.g. "Alpha <noreply@example.com>". Unset, noreply at PUBLIC_ORIGIN's host.
SMTP_FROM=
# [secret] SMTP server for sign-in code and invitation emails, as smtp(s)://user:pass@host:port. Used only when RESEND_API_KEY is unset (a self-hosted Alpha's own mail).
SMTP_URL=

# ── SYFTHUB ─────────────────────────────────────────────────────────────────────────────────────
# [warn] [secret] SyftHub token for federated retrieval. Unset, federated retrieval is off, even with every other SYFTHUB_* set.
SYFTHUB_API_TOKEN=
# SyftHub base URL. Default https://syfthub.openmined.org.
SYFTHUB_BASE_URL=
# "off" turns off the relevance check before SyftHub sources are queried.
SYFTHUB_CATALOG_PREGATE=
# Cache lifetime of SyftHub source discovery, in ms. Default 300000.
SYFTHUB_DISCOVERY_CACHE_TTL_MS=
# Minimum discovery score for a SyftHub source. Default 0.4.
SYFTHUB_DISCOVERY_MIN_SCORE=
# SyftHub sources considered per turn. Default 5.
SYFTHUB_DISCOVERY_TOP_K=
# SyftHub discovery timeout, in ms. Default 3000.
SYFTHUB_DISCOVER_TIMEOUT_MS=
# "true" queries only SyftHub sources that need no payment.
SYFTHUB_GUEST_MODE=
# Whether the SyftHub source pick fails closed when its check cannot run.
SYFTHUB_PICK_GATE_FAILCLOSED=
# Minimum reranker score for a picked SyftHub source. Default 0.01.
SYFTHUB_PICK_MIN_RERANK=
# Limits SyftHub to its prompt-restricted mode and turns off the retrieval source router and warm catalog.
SYFTHUB_PROMPT_ONLY=
# Turns on SyftHub's prompt-restricted routing.
SYFTHUB_PROMPT_ROUTING=
# SyftHub retrieval timeout, in ms. Default 9000.
SYFTHUB_RETRIEVE_TIMEOUT_MS=
# Chunks retrieved from each SyftHub source. Default 5.
SYFTHUB_RETRIEVE_TOP_K=
# Score above which the router picks a SyftHub source without asking the model. Default 0.9.
SYFTHUB_ROUTER_AUTOPICK_SCORE=
# "off" turns off the router's semantic cache. Default on.
SYFTHUB_ROUTER_SEMCACHE=
# Similarity for a semantic cache hit. Default 0.95.
SYFTHUB_ROUTER_SEMCACHE_MIN=
# Minimum similarity for a SyftHub chunk. Default 0.5.
SYFTHUB_SIMILARITY_THRESHOLD=
# SyftHub sources never to query.
SYFTHUB_SOURCE_BLOCKLIST=
# Limits SyftHub sources to one owner.
SYFTHUB_SOURCE_OWNER=
# Limits SyftHub sources to one tag.
SYFTHUB_SOURCE_TAG=

# ── THIRD ───────────────────────────────────────────────────────────────────────────────────────
# Display name of the second second-opinion model.
THIRD_OPINION_DISPLAY_NAME=
# Second second-opinion model. Off a Vercel deployment only; on Vercel, config/inference.ts decides.
THIRD_OPINION_MODEL=

# ── TRANSCRIPTION ───────────────────────────────────────────────────────────────────────────────
# Speech-to-text endpoint. Default https://router.huggingface.co/hf-inference/models.
TRANSCRIPTION_BASE_URL=
# Speech-to-text model for dictation. Dictation also needs its feature flag.
TRANSCRIPTION_MODEL=

# ── TRIG ────────────────────────────────────────────────────────────────────────────────────────
# [secret] CI only: issue-tracker key for the CI job that syncs feature-flag state to tracker labels. Other CI jobs mint a token from CI_LINEAR_CLIENT_ID/_SECRET and fall back to this one. The app does not read it.
TRIG_LINEAR_API_KEY=
# [secret] CI only: PostHog key for the scheduled flag workflows. The app does not read it.
TRIG_POSTHOG_API_KEY=
# CI only: PostHog host for the scheduled flag workflows. The app does not read it.
TRIG_POSTHOG_HOST=
# CI only: PostHog project for the scheduled flag workflows. The app does not read it.
TRIG_POSTHOG_PROJECT_ID=

# ── WORKSPACE ───────────────────────────────────────────────────────────────────────────────────
# Workspace invites one account can send per day. Default 20.
WORKSPACE_INVITE_MAX_PER_DAY=
# Workspace invites an account under a week old can send per day. Default 5, capped at WORKSPACE_INVITE_MAX_PER_DAY.
WORKSPACE_INVITE_NEW_ACCOUNT_MAX_PER_DAY=
# Workspace invites per day across the site. Default 500.
WORKSPACE_INVITE_SITE_MAX_PER_DAY=

# ── MISC ────────────────────────────────────────────────────────────────────────────────────────
# Model that writes the second-opinion verdict. Off a Vercel deployment only; on Vercel, config/inference.ts decides.
AGGREGATOR_MODEL=
# Model that plans each turn and answers arithmetic, when the math-routing flag is on; unset, those turns stay on the default model. Off a Vercel deployment only; on Vercel, config/inference.ts decides.
ARITHMETIC_ROUTE_MODEL=
# "true" makes sign-in mandatory.
AUTOMATIC_LOGIN=
# [warn] [secret] Signing secret for sessions. Set it in every shared environment: the auth routes are mounted whatever the sign-in flag says, and a missing or rotated value signs everyone out.
BETTER_AUTH_SECRET=
# Maximum request body size, read only by SvelteKit's Node adapter. The Vercel build does not read it.
BODY_SIZE_LIMIT=
# "true" makes the model re-derive an answer the user challenges instead of conceding. Default off.
CHALLENGE_REDERIVE_ENABLED=
# Comma-separated second-opinion models, in fan-out order. Off a Vercel deployment only; on Vercel, config/inference.ts decides.
COMPARE_PANEL=
# [warn] [secret] Secret used to hash IP addresses for the "Get involved" form. Unset turns off its per-IP daily cap, its per-address code and invite caps and its source-pair cap.
CONTRIBUTION_IP_PEPPER=
# Ties the session to another cookie, as in upstream chat-ui.
COUPLE_SESSION_WITH_COOKIE_NAME=
# [warn] [secret] Bearer token the scheduled cleanup and probes jobs present. Outside local dev both routes refuse every call while it is unset, so expired rows are never deleted and the probes never alert.
CRON_SECRET=
# [required] [secret] Postgres connection string; falls back to POSTGRES_URL. Locally: postgres://postgres:postgres@localhost:5432/aipotluck_test (pnpm db:start). Preview and production are separate databases.
DATABASE_URL=
# This deployment's own hostname, no scheme (runtimeEnv.js deploymentUrl()). Unset on Vercel, which supplies VERCEL_URL instead and that is the fallback. A per-PR preview's passkey RP ID is this host.
DEPLOYMENT_URL=
# [warn] Which environment this deployment is: production, preview or development. Falls back to VERCEL_ENV. Feature flags and model lists depend on it: on a host without VERCEL_ENV, leaving it unset makes every environment-scoped flag evaluate off.
DEPLOY_ENV=
# The RAG entity-scope guard's model. models.ts registers it like any side-call model: on the Mistral side-call lane when MISTRAL_MODELS lists it and side-call-own-lane is on, otherwise on the compare endpoint (SECOND_OPINION_BASE_URL/API_KEY); unregistered, the guard falls back to the default endpoint and logs an error. On a Vercel deployment config.ts serves ROLE_MODELS in config/inference.ts and ignores this var; it decides only off Vercel (local dev, CI, evals).
ENTITY_SCOPE_MODEL=
# Deprecated upstream chat-ui setting. Setting it only logs a deprecation warning.
EXPOSE_API=
# Vercel function regions, comma-separated (for example fra1), read at build time. Unset, the region beside the Neon host in DATABASE_URL (src/lib/functionRegion.js), or Vercel's default (iad1) when the URL names no mapped Neon region.
FUNCTION_REGION=
# Test only: "true" lets local tests and the scenario suite force feature flags with a cookie. Refused in production; a hosted preview also requires the E2E_OTP_BYPASS_TOKEN key cookie.
FUZZ_OVERRIDE_ENABLED=
# [warn] [secret] Postgres URL of the gap map database (pooled endpoint). Unset, the map, the org and product pages, the sitemap and /api/data-freshness fail.
GAP_MAP_DATABASE_URL=
# Watchdog for an ordinary turn, in ms. Default 45000. Agent turns use AGENT_GENERATION_TIMEOUT_MS. Capped at 155000. Needs a redeploy to change.
GENERATION_TIMEOUT_MS=
# Requests per day across the site. Unset or 0, no cap.
GLOBAL_DAILY_REQUEST_CAP=
# OpenAI-compatible base URL of the Shieldstral guard endpoint. detectors/shieldstral.ts:30 — the SYNC INPUT GATE (guardGate.ts:1, Shieldstral-1.0-3B). Every turn passes through it before reaching the model and it is what DECLINES a turn; guardPrimaryConfigured() derives entirely from this var being set. An UNKNOWN from this endpoint — non-2xx, garbled body, network error, op-deadline — fails CLOSED and labels the turn child_safety with generic child copy. So pointing this var at the wrong host does not degrade a log line; it declines real people's messages. Token and bill-to reuse HF_TOKEN||OPENAI_API_KEY and HF_BILL_TO; model + timeout are fixed constants. The name is historical: it predates the Shieldstral guard (detectors/shieldstral.ts:27). Privacy note: this endpoint receives the full text of every message, so name it in your deployment's privacy notice.
GUARD_SHADOW_URL=
# [secret] Key that seals a guest's session when www hands it to alpha (guestHandoffPage.ts). Set the same value on www and alpha. Unset, BETTER_AUTH_SECRET seals it, and with neither a guest arriving from www starts a new session on alpha.
GUEST_HANDOFF_SECRET=
# Name of this production instance, when one codebase serves several sites (for example an event site). Unset is the main site. Sets the session cookie name, passkey RP ID and the instance property on flag evaluations. Must be a lowercase label; anything else fails boot.
INSTANCE=
# Watchdog for a turn on a user-run local model, in ms. Default 155000, the ceiling, because a cold local model can take a long time to load. Needs a redeploy to change.
LOCAL_GENERATION_TIMEOUT_MS=
# Log level. Default "info".
LOG_LEVEL=
# Most turns generating at once per instance. Unset or 0, no limit.
MAX_CONCURRENT_GENERATIONS=
# JSON array of MCP servers whose tools the chat may call.
MCP_SERVERS=
# Base URL of the Mila suicide-prevention classifier (TEI, `POST /tokenize` and `/predict`) that the `mila-sp-output-guard` flag turns on (detectors/milaSp.ts). Optional on Current AI's deployments: with DEPLOY_ENV (or VERCEL_ENV) production or preview and this unset, the endpoint is the committed `deployed_api_base` in web/config/safetyScreen.ts. Anywhere else (local dev, CI, a self-host) it is the only address: unset means the classifier is not configured, and flag on logs an error and checks nothing, even with HF_TOKEN set. Set, it wins on every deployment.
MILA_SP_ENDPOINT_URL=
# Off a Vercel deployment only (local dev, CI, evals): comma-separated model ids the picker offers, the first being the default, or * for all. Default swiss-ai/apertus-v1.5-70b. On Vercel the picker comes from config/inference.ts and this is ignored.
MODEL_ALLOWLIST=
# Dedicated endpoint for the multilingual embedding model the self-identity check uses. Unset, calls go to Hugging Face serverless, which can queue for many seconds under load.
MULTILINGUAL_EMBEDDING_ENDPOINT_URL=
# "true" declares that the deployment can serve images and audio. Image input also needs its feature flag.
MULTIMODAL_ENABLED=
# Kept from upstream chat-ui (retired model ids). Nothing reads it; retired ids are listed in code.
OLD_MODELS=
# [secret] Shared secret the scheduled production probes send as x-probe-token. A probe turn a screen declines then writes its safety_events row with the probe's name in safety_events.probe, so counts of real declines can leave it out. Unset, no row is marked and probe declines count as real ones.
PROBE_MARKER_TOKEN=
# The project's production hostname, no scheme (runtimeEnv.js productionUrl()), read at BUILD time by vite.config.ts for the canonical origin of prerendered pages. Unset on Vercel, which supplies VERCEL_PROJECT_PRODUCTION_URL instead and that is the fallback.
PRODUCTION_URL=
# "true" shows a summary of the model's reasoning.
REASONING_SUMMARY=
# The region this server runs in (runtimeEnv.js region()), shown as the app hop of a turn's serving route. Unset on Vercel, which supplies VERCEL_REGION instead and that is the fallback. Not FUNCTION_REGION, which picks the region at build time.
REGION=
# [secret] Test only: Postgres URL of the database of recorded model replies that preview scenario runs replay. Read only for requests carrying the fault-inject token. Never set in production. Unset on preview, a replayed turn logs the misconfiguration and runs live.
REPLAY_DATABASE_URL=
# [warn] [secret] Resend key for sign-in code emails. Unset, codes are logged instead of sent and sign-in still works.
RESEND_API_KEY=
# [secret] Bearer token the agent service presents to POST /chat/api/safety/screen. Set the same value in the agent service's config. Config, not a switch: the route returns 503 while it is unset.
SAFETY_SCREEN_TOKEN=
# [secret] CI only: Axiom token for the dataset where failing scenario tests are recorded and read back. The app does not read it.
SCENARIO_FAILURES_AXIOM_TOKEN=
# adapter-node only (self-hosted container): seconds to wait for open requests, chat streams included, after SIGTERM, and then again for background work (gracefulShutdown.ts). Default 30. Set the orchestrator's stop grace period to at least twice this. Unused on Vercel.
SHUTDOWN_TIMEOUT=
# How long a turn may go without a new token before it counts as stalled, in ms. Default 45000. Capped at that turn's own generation timeout. Needs a redeploy to change.
SILENCE_TIMEOUT_MS=
# [secret] Webhook that receives operational alerts. Anyone with the URL can post to the channel, so keep it server-only. Unset, alerts are logged but not delivered.
SLACK_ALERT_WEBHOOK=
# [warn] Comma-separated host=label pairs naming model hosts the UI may describe as sovereign.
SOVEREIGN_HOSTS=
# The Better Stack status page the chat's incident banner reads (its /index.json) and links to. Unset, a hosted or local process uses the deployment file's statusPageUrl (none by default), and a self-host (ALPHA_EDITION=selfhost) has no status page and shows no banner.
STATUS_PAGE_URL=
# Model for side calls such as titles, the search classifier and groundcheck. Off a Vercel deployment only; on Vercel, config/inference.ts decides.
TASK_MODEL=
# JSON5 object of per-user limits, such as conversations and message length.
USAGE_LIMITS=
# [secret] "true" sends each user's own Hugging Face token instead of the server's.
USE_USER_TOKEN=
# [secret] Vercel's Protection Bypass for Automation token (Project Settings → Deployment Protection). Set by the deployment, not by Vercel: without it, platform SSO answers the every-minute warm cron with 401 before the app runs, and the `db` warm leg stops keeping the database connection open during quiet hours (warm.ts). Also read directly by scripts/warm-cache.mjs. Exempt from the `^VERCEL_` platform-noise denylist in config/platform-noise.mjs, so `env-audit --prod` still lists it.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Test only: overrides every warm-up check's throttle window. Leave unset in every deployment; a large value suppresses health checks. A non-numeric or non-positive value is ignored.
WARM_THROTTLE_MS=
# "true" turns on an experimental world-model verification pass before answering. Default off.
WORLD_MODEL_PREPASS=
# Base URL of the Zentropi S1 judge (`POST /v1/systemone`) that the `s1-safety-judge` flag turns on (detectors/s1.ts). Optional on Current AI's deployments: with DEPLOY_ENV (or VERCEL_ENV) production or preview and this unset, the endpoint is the committed `deployed_api_base` in web/config/safetyScreen.ts. Anywhere else (local dev, CI, a self-host) it is the only address: unset means the judge is not configured, and flag on logs an error and fails every turn closed, as it always has with HF_TOKEN unset. Set, it wins on every deployment.
ZENTROPI_S1_ENDPOINT_URL=
